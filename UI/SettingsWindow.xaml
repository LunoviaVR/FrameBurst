<Window
    x:Class="FrameBurst.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FrameBurst.UI"
    Title="FrameBurst Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>
            <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="FrameBurst Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Capture" Tag="Capture" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE722;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Output" Tag="Output">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer Padding="32,0,32,24">
                <Grid MaxWidth="820">

                    <!-- Capture -->
                    <StackPanel x:Name="CapturePage" Spacing="4">
                        <TextBlock Text="Capture" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}" />
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,0,0,4"
                                 Message="Click a box and press a key combination. Backspace clears it. If PrintScreen won't register, turn off &quot;Use the Print screen key to open screen capture&quot; in Windows Settings › Accessibility › Keyboard." />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xF407;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Region" />
                                    <TextBlock Text="Freeze the screen, then drag an area or click a window" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ui:HotkeyBox x:Name="HkRegion" Grid.Column="2" Width="220" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F4;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="All monitors" />
                                    <TextBlock Text="The whole desktop in one image" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ui:HotkeyBox x:Name="HkFull" Grid.Column="2" Width="220" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7F8;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Monitor under cursor" />
                                    <TextBlock Text="The display the mouse is on" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ui:HotkeyBox x:Name="HkMonitor" Grid.Column="2" Width="220" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE737;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Active window" />
                                    <TextBlock Text="The window in the foreground" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ui:HotkeyBox x:Name="HkWindow" Grid.Column="2" Width="220" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE916;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Delay" />
                                    <TextBlock Text="Milliseconds to wait before capturing" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <NumberBox x:Name="Delay" Grid.Column="2" Width="160" VerticalAlignment="Center" Minimum="0" Maximum="10000"
                                           SmallChange="250" LargeChange="1000" SpinButtonPlacementMode="Inline" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B0;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Include mouse cursor" />
                                    <TextBlock Text="Draw the pointer into the screenshot" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="CursorToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Output -->
                    <StackPanel x:Name="OutputPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Output" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="File" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <FontIcon Glyph="&#xE838;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Screenshot folder" />
                                    <TextBlock Text="Where saved captures go" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Browse…" Click="Browse_Click" VerticalAlignment="Center" />
                                <TextBox x:Name="Folder" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <FontIcon Glyph="&#xE787;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Dated subfolders" />
                                    <TextBlock Text="Sort captures by the date they were taken. Use \ between levels, e.g. {yyyy}\{MM}\{dd} or {yyyy}\{MM MMMM}" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="DateFolderToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                                <TextBox x:Name="DateFolderPattern" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <FontIcon Glyph="&#xE8AC;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="File name" />
                                    <TextBlock Style="{StaticResource CardDescription}">
                                        <Run Text="Text in {braces} is a .NET date format, e.g. {yyyy-MM-dd_HH-mm-ss}." />
                                        <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings">Read more</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <TextBox x:Name="Pattern" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE9E9;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PNG compression" />
                                    <TextBlock Text="PNG is lossless at every setting: this only trades file size for speed" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="Png" Grid.Column="2" Width="200" VerticalAlignment="Center">
                                    <x:String>Fast (largest files)</x:String>
                                    <x:String>Balanced</x:String>
                                    <x:String>Smallest (slowest)</x:String>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE706;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Save HDR copy" />
                                    <TextBlock Text="When an HDR monitor is captured, also save a 16-bit HDR PNG (_HDR.png) without edits or cursor" Style="{StaticResource CardDescription}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="HdrToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="After capture" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE74E;" FontSize="20" />
                                <TextBlock Grid.Column="1" Text="Save to file" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="SaveToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8C8;" FontSize="20" />
                                <TextBlock Grid.Column="1" Text="Copy to clipboard" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="ClipToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA8F;" FontSize="20" />
                                <TextBlock Grid.Column="1" Text="Show notification" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="NotifyToggle" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,0" />
                        <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20,16">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Image x:Name="AboutIcon" Width="56" Height="56" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="FrameBurst" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CardDescription}" />
                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="A system tray screenshot tool built for the highest-quality capture possible. Every step runs on the GPU through Direct3D 11, so captures are pixel-exact, fast, and work over full-screen games. Annotate before you pick a region, then save lossless PNGs (with an optional HDR copy) or copy straight to the clipboard." />
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                                        <HyperlinkButton x:Name="ReleaseNotes" Content="Release notes" Padding="0" />
                                        <HyperlinkButton x:Name="SourceLink" Content="Source code" Padding="0" />
                                        <TextBlock Text="Licensed under the GNU GPL v3.0" Style="{StaticResource CardDescription}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <FontIcon x:Name="UpdateGlyph" Glyph="&#xE895;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="UpdateTitle" Text="Check for updates" />
                                    <TextBlock x:Name="UpdateStatus" Text="See whether a newer version of FrameBurst is available" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                    <Button x:Name="CheckButton" Content="Check for updates" Click="CheckNow_Click" />
                                    <Button x:Name="InstallButton" Content="Download and install" Style="{StaticResource AccentButtonStyle}"
                                            Click="Install_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <ProgressBar x:Name="DownloadProgress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE823;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Check for updates automatically" />
                                    <TextBlock Text="FrameBurst checks GitHub once a day and asks before installing anything" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutoUpdate" Grid.Column="2" MinWidth="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Support FrameBurst" Style="{StaticResource SectionHeader}" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEB51;" FontSize="20" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Leave a tip" />
                                    <TextBlock Text="FrameBurst is free and open source. If it saves you time, a tip helps keep it going." Style="{StaticResource CardDescription}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="Tip_Click" VerticalAlignment="Center" Padding="10,6,14,6"
                                        ToolTipService.ToolTip="cash.app/$LunoviaVR">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <!-- Cash App logo: white dollar sign on the brand-green rounded square -->
                                        <Border Width="22" Height="22" CornerRadius="6" Background="#00D64F">
                                            <TextBlock Text="$" Foreground="White" FontWeight="Bold" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                        </Border>
                                        <TextBlock Text="Tip" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="24,12" ColumnSpacing="8"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="Error" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Save" Style="{StaticResource AccentButtonStyle}" MinWidth="120" Click="Save_Click" />
            <Button Grid.Column="2" Content="Cancel" MinWidth="120" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Window>
