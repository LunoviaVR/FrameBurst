<Window
    x:Class="FrameBurst.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FrameBurst.UI"
    Title="FrameBurst Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="SaveAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Title bar (drag region; caption buttons are drawn by the system on the right) -->
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel x:Name="TitleContent" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center">
                    <Run Text="FrameBurst" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Run Text="  Settings" Foreground="{ThemeResource TextSecondaryBrush}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
                        CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="760"
                        IsSettingsVisible="False" IsPaneToggleButtonVisible="False" OpenPaneLength="208"
                        IsTitleBarAutoPaddingEnabled="False" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Capture" Tag="Capture" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE722;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Output" Tag="Output">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="PageScroller" Padding="{StaticResource PagePadding}">
                <Grid MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">

                    <!-- ===================================================== Capture -->
                    <StackPanel x:Name="CapturePage">
                        <StackPanel.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="12" /></TransitionCollection></StackPanel.Transitions>
                        <TextBlock Text="Capture" Style="{StaticResource PageTitleStyle}" />

                        <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeadingStyle}" />
                        <TextBlock Style="{StaticResource InlineHintStyle}">
                            <Run Text="Click a box and press a key combination. Backspace clears it. If PrintScreen won't register, turn off &quot;Use the Print screen key to open screen capture&quot; in Windows Settings › Accessibility › Keyboard." />
                        </TextBlock>
                        <ui:SettingsGroup AutomationProperties.Name="Hotkeys">
                            <ui:SettingsRow Glyph="&#xF407;" Header="Region" Description="Freeze the screen, then drag an area or click a window">
                                <ui:HotkeyBox x:Name="HkRegion" Width="{StaticResource ActionColumnWidth}" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE7F4;" Header="All monitors" Description="The whole desktop in one image">
                                <ui:HotkeyBox x:Name="HkFull" Width="{StaticResource ActionColumnWidth}" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE7F8;" Header="Monitor under cursor" Description="The display the mouse is on">
                                <ui:HotkeyBox x:Name="HkMonitor" Width="{StaticResource ActionColumnWidth}" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE737;" Header="Active window" Description="The window in the foreground">
                                <ui:HotkeyBox x:Name="HkWindow" Width="{StaticResource ActionColumnWidth}" />
                            </ui:SettingsRow>
                        </ui:SettingsGroup>

                        <TextBlock Text="Behaviour" Style="{StaticResource SectionHeadingStyle}" />
                        <ui:SettingsGroup AutomationProperties.Name="Behaviour">
                            <ui:SettingsRow Glyph="&#xE916;" Header="Delay" Description="Milliseconds to wait before capturing">
                                <NumberBox x:Name="Delay" Width="160" Minimum="0" Maximum="10000"
                                           SmallChange="250" LargeChange="1000" SpinButtonPlacementMode="Inline" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE8B0;" Header="Include mouse cursor" Description="Draw the pointer into the screenshot">
                                <ToggleSwitch x:Name="CursorToggle" MinWidth="0" />
                            </ui:SettingsRow>
                        </ui:SettingsGroup>
                    </StackPanel>

                    <!-- ===================================================== Output -->
                    <StackPanel x:Name="OutputPage" Visibility="Collapsed">
                        <StackPanel.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="12" /></TransitionCollection></StackPanel.Transitions>
                        <TextBlock Text="Output" Style="{StaticResource PageTitleStyle}" />

                        <TextBlock Text="File" Style="{StaticResource SectionHeadingStyle}" />
                        <ui:SettingsGroup AutomationProperties.Name="File">
                            <ui:SettingsRow Glyph="&#xE838;" Header="Screenshot folder" Description="Where saved captures go">
                                <Button Content="Browse…" Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click" />
                                <ui:SettingsRow.Footer>
                                    <TextBox x:Name="Folder" AutomationProperties.Name="Screenshot folder path" />
                                </ui:SettingsRow.Footer>
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE787;" Header="Dated subfolders"
                                            Description="Sort captures by the date they were taken. Use \ between levels, e.g. {yyyy}\{MM}\{dd} or {yyyy}\{MM MMMM}">
                                <ToggleSwitch x:Name="DateFolderToggle" MinWidth="0" />
                                <ui:SettingsRow.Footer>
                                    <TextBox x:Name="DateFolderPattern" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.Name="Subfolder pattern" />
                                </ui:SettingsRow.Footer>
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE8AC;" Header="File name">
                                <ui:SettingsRow.Description>
                                    <TextBlock Style="{StaticResource CaptionStyle}">
                                        <Run Text="Text in {braces} is a .NET date format, e.g. {yyyy-MM-dd_HH-mm-ss}." />
                                        <Hyperlink NavigateUri="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings">Read more</Hyperlink>
                                    </TextBlock>
                                </ui:SettingsRow.Description>
                                <ui:SettingsRow.Footer>
                                    <TextBox x:Name="Pattern" FontFamily="{StaticResource MonoFontFamily}" AutomationProperties.Name="File name pattern" />
                                </ui:SettingsRow.Footer>
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE9E9;" Header="PNG compression"
                                            Description="PNG is lossless at every setting: this only trades file size for speed">
                                <ComboBox x:Name="Png" Width="{StaticResource ActionColumnWidth}">
                                    <x:String>Fast (largest files)</x:String>
                                    <x:String>Balanced</x:String>
                                    <x:String>Smallest (slowest)</x:String>
                                </ComboBox>
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE706;" Header="Save HDR copy"
                                            Description="When an HDR monitor is captured, also save a 16-bit HDR PNG (_HDR.png) without edits or cursor">
                                <ToggleSwitch x:Name="HdrToggle" MinWidth="0" />
                            </ui:SettingsRow>
                        </ui:SettingsGroup>

                        <TextBlock Text="After capture" Style="{StaticResource SectionHeadingStyle}" />
                        <ui:SettingsGroup AutomationProperties.Name="After capture">
                            <ui:SettingsRow Glyph="&#xE74E;" Header="Save to file">
                                <ToggleSwitch x:Name="SaveToggle" MinWidth="0" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE8C8;" Header="Copy to clipboard">
                                <ToggleSwitch x:Name="ClipToggle" MinWidth="0" />
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xEA8F;" Header="Show notification">
                                <ToggleSwitch x:Name="NotifyToggle" MinWidth="0" />
                            </ui:SettingsRow>
                        </ui:SettingsGroup>
                    </StackPanel>

                    <!-- ===================================================== About -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                        <StackPanel.Transitions><TransitionCollection><EntranceThemeTransition FromVerticalOffset="12" /></TransitionCollection></StackPanel.Transitions>
                        <TextBlock Text="About" Style="{StaticResource PageTitleStyle}" />

                        <!-- Product header: flat, no card - the logo and type carry it. -->
                        <Grid Margin="2,24,0,0" ColumnSpacing="{StaticResource Space20}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Image x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                                    <TextBlock Text="FrameBurst" Style="{StaticResource SubtitleTextBlockStyle}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource BodySecondaryStyle}" TextWrapping="Wrap" MaxWidth="620" HorizontalAlignment="Left"
                                           Text="A system tray screenshot tool built for the highest-quality capture possible. Capture and colour conversion run on the GPU through Direct3D 11, so captures are pixel-exact, fast, and work over full-screen games. Annotate before you pick a region, then save lossless PNGs (with an optional HDR copy) or copy straight to the clipboard." />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}" Margin="0,6,0,0">
                                    <HyperlinkButton x:Name="ReleaseNotes" Content="Release notes" Style="{StaticResource InlineLinkStyle}" />
                                    <HyperlinkButton x:Name="SourceLink" Content="Source code" Style="{StaticResource InlineLinkStyle}" />
                                    <TextBlock Text="GNU GPL v3.0" Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Updates" Style="{StaticResource SectionHeadingStyle}" />
                        <ui:SettingsGroup AutomationProperties.Name="Updates">
                            <!-- Header / Description are driven by SetUpdateState; live region so state changes are announced. -->
                            <ui:SettingsRow x:Name="UpdateRow" Header="Check for updates"
                                            Description="See whether a newer version of FrameBurst is available"
                                            AutomationProperties.LiveSetting="Polite">
                                <ui:SettingsRow.Icon><FontIcon x:Name="UpdateGlyph" Glyph="&#xE895;" /></ui:SettingsRow.Icon>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                    <ProgressRing x:Name="UpdateRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
                                    <Button x:Name="CheckButton" Content="Check for updates" Style="{StaticResource SecondaryButtonStyle}" Click="CheckNow_Click" />
                                    <Button x:Name="InstallButton" Content="Download and install" Style="{StaticResource PrimaryButtonStyle}"
                                            Click="Install_Click" Visibility="Collapsed" />
                                </StackPanel>
                                <ui:SettingsRow.Footer>
                                    <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" AutomationProperties.Name="Download progress" />
                                </ui:SettingsRow.Footer>
                            </ui:SettingsRow>
                            <ui:SettingsRow Glyph="&#xE823;" Header="Check for updates automatically"
                                            Description="FrameBurst checks GitHub once a day and asks before installing anything">
                                <ToggleSwitch x:Name="AutoUpdate" MinWidth="0" />
                            </ui:SettingsRow>
                        </ui:SettingsGroup>

                        <TextBlock Text="Support FrameBurst" Style="{StaticResource SectionHeadingStyle}" />
                        <ui:SettingsGroup AutomationProperties.Name="Support FrameBurst">
                            <ui:SettingsRow Glyph="&#xEB51;" Header="Leave a tip"
                                            Description="FrameBurst is free and open source. If it saves you time, a tip helps keep it going.">
                                <Button Click="Tip_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5,14,6"
                                        ToolTipService.ToolTip="cash.app/$LunoviaVR" AutomationProperties.Name="Tip with Cash App">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                                        <Image x:Name="CashAppLogo" Width="20" Height="20" />
                                        <TextBlock Text="Tip" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </ui:SettingsRow>
                        </ui:SettingsGroup>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>

        <!-- Footer -->
        <Grid Grid.Row="2" Style="{StaticResource FooterBarStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center" Visibility="Collapsed">
                <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="{ThemeResource DangerBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="Error" Foreground="{ThemeResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButtonStyle}" MinWidth="{StaticResource FooterButtonMinWidth}"
                    Click="Save_Click" ToolTipService.ToolTip="Save (Ctrl+S)" />
            <Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinWidth="{StaticResource FooterButtonMinWidth}"
                    Click="Cancel_Click" ToolTipService.ToolTip="Cancel (Esc)" />
        </Grid>
    </Grid>
</Window>
