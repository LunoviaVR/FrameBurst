<!--
    FrameBurst design tokens. Every colour, opacity, radius, spacing step and text style used by the WinUI
    windows comes from here; UI/OverlayTheme.cs mirrors the same values for the GDI+ capture overlays.

    Material levels
      0  window base      Mica (Settings) / desktop acrylic (dialogs) - native, GPU-composited, the OS falls
                          back to a solid colour when transparency effects are off.
      1  glass            GlassFillBrush / PanelFillBrush: translucent layers over the backdrop (no extra blur).
      2  elevated glass   ElevatedFillBrush: flyouts, dialogs, popups.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ accent: FrameBurst blue
         Overrides the system accent so every stock control (toggles, primary buttons, selection,
         focus, progress) uses the brand colour. Dark1 keeps white text at 4.5:1 in light theme and
         Light2 keeps dark text at 4.5:1 in dark theme. -->
    <Color x:Key="SystemAccentColor">#00A8FF</Color>
    <Color x:Key="SystemAccentColorLight1">#2EB6FF</Color>
    <Color x:Key="SystemAccentColorLight2">#5CC6FF</Color>
    <Color x:Key="SystemAccentColorLight3">#99DCFF</Color>
    <Color x:Key="SystemAccentColorDark1">#0076BC</Color>
    <Color x:Key="SystemAccentColorDark2">#005C93</Color>
    <Color x:Key="SystemAccentColorDark3">#00446C</Color>

    <!-- Opacity levels (OpacityPanel / Glass / Elevated / Hover / Pressed / Selected / Divider) are defined
         per theme below: white layers on dark need far less alpha than white layers on light. -->

    <!-- ============================================================ radius
         Two steps only: controls, and surfaces (panels, groups, dialogs, flyouts). Same values as the
         WinUI ControlCornerRadius / OverlayCornerRadius so stock and custom controls line up. -->
    <CornerRadius x:Key="RadiusControl">4</CornerRadius>
    <CornerRadius x:Key="RadiusSurface">8</CornerRadius>

    <!-- ============================================================ spacing (4 / 8 / 12 / 16 / 20 / 24 / 32 / 40) -->
    <x:Double x:Key="Space4">4</x:Double>
    <x:Double x:Key="Space8">8</x:Double>
    <x:Double x:Key="Space12">12</x:Double>
    <x:Double x:Key="Space16">16</x:Double>
    <x:Double x:Key="Space20">20</x:Double>
    <x:Double x:Key="Space24">24</x:Double>
    <x:Double x:Key="Space32">32</x:Double>
    <x:Double x:Key="Space40">40</x:Double>
    <Thickness x:Key="PagePadding">40,24,40,32</Thickness>
    <Thickness x:Key="RowPadding">16,12,16,12</Thickness>
    <Thickness x:Key="SectionHeadingMargin">2,28,0,8</Thickness>
    <Thickness x:Key="FooterPadding">24,16,24,16</Thickness>
    <x:Double x:Key="RowMinHeight">64</x:Double>
    <x:Double x:Key="RowIconSize">16</x:Double>
    <x:Double x:Key="RowStackBreakpoint">520</x:Double>
    <x:Double x:Key="ContentMaxWidth">860</x:Double>
    <x:Double x:Key="ActionColumnWidth">220</x:Double>
    <x:Double x:Key="FooterButtonMinWidth">112</x:Double>

    <!-- ============================================================ typography -->
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- ============================================================ text styles -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,0" />
    </Style>
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="{StaticResource SectionHeadingMargin}" />
    </Style>
    <Style x:Key="BodyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="BodySecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <ResourceDictionary.ThemeDictionaries>

        <!-- ======================================================== dark -->
        <ResourceDictionary x:Key="Default">
            <Color x:Key="TextPrimaryColor">#F0F1F3</Color>
            <Color x:Key="TextSecondaryColor">#B4B8BE</Color>
            <Color x:Key="TextMutedColor">#8C9097</Color>
            <Color x:Key="DangerColor">#FF99A4</Color>
            <Color x:Key="WarningColor">#FCE100</Color>
            <Color x:Key="SuccessColor">#6CCB5F</Color>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

            <!-- opacity levels (white layers) -->
            <x:Double x:Key="OpacityPanel">0.035</x:Double>
            <x:Double x:Key="OpacityGlass">0.055</x:Double>
            <x:Double x:Key="OpacityElevated">0.92</x:Double>
            <x:Double x:Key="OpacityHover">0.06</x:Double>
            <x:Double x:Key="OpacityPressed">0.035</x:Double>
            <x:Double x:Key="OpacitySelected">0.14</x:Double>
            <x:Double x:Key="OpacityStroke">0.08</x:Double>
            <x:Double x:Key="OpacityDivider">0.07</x:Double>

            <!-- level 1 -->
            <SolidColorBrush x:Key="PanelFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityPanel}" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityGlass}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityStroke}" />
            <!-- level 2 -->
            <SolidColorBrush x:Key="ElevatedFillBrush" Color="#2B2B2F" Opacity="{StaticResource OpacityElevated}" />
            <SolidColorBrush x:Key="ElevatedBorderBrush" Color="#FFFFFF" Opacity="0.12" />

            <SolidColorBrush x:Key="HoverFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityHover}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityPressed}" />
            <SolidColorBrush x:Key="SelectedFillBrush" Color="{ThemeResource SystemAccentColor}" Opacity="{StaticResource OpacitySelected}" />
            <SolidColorBrush x:Key="DividerBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityDivider}" />
            <SolidColorBrush x:Key="EdgeHighlightBrush" Color="#FFFFFF" Opacity="0.05" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemAccentColorLight2}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="StatusTintBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityHover}" />

            <!-- WinUI lightweight overrides: hierarchy comes from our own layers, not stock fills -->
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="PanelFillBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="GlassBorderBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="HoverFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="HoverFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="PressedFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="PressedFillBrush" />
            <StaticResource x:Key="FocusStrokeColorOuterBrush" ResourceKey="FocusBrush" />
        </ResourceDictionary>

        <!-- ======================================================== light -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="TextPrimaryColor">#1B1C1E</Color>
            <Color x:Key="TextSecondaryColor">#55595F</Color>
            <Color x:Key="TextMutedColor">#73777D</Color>
            <Color x:Key="DangerColor">#C42B1C</Color>
            <Color x:Key="WarningColor">#9D5D00</Color>
            <Color x:Key="SuccessColor">#0F7B0F</Color>

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

            <!-- opacity levels (white surfaces, black overlays) -->
            <x:Double x:Key="OpacityPanel">0.45</x:Double>
            <x:Double x:Key="OpacityGlass">0.72</x:Double>
            <x:Double x:Key="OpacityElevated">0.94</x:Double>
            <x:Double x:Key="OpacityHover">0.04</x:Double>
            <x:Double x:Key="OpacityPressed">0.025</x:Double>
            <x:Double x:Key="OpacitySelected">0.10</x:Double>
            <x:Double x:Key="OpacityStroke">0.07</x:Double>
            <x:Double x:Key="OpacityDivider">0.07</x:Double>

            <SolidColorBrush x:Key="PanelFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityPanel}" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="#FFFFFF" Opacity="{StaticResource OpacityGlass}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#000000" Opacity="{StaticResource OpacityStroke}" />
            <SolidColorBrush x:Key="ElevatedFillBrush" Color="#FAFAFB" Opacity="{StaticResource OpacityElevated}" />
            <SolidColorBrush x:Key="ElevatedBorderBrush" Color="#000000" Opacity="0.10" />

            <SolidColorBrush x:Key="HoverFillBrush" Color="#000000" Opacity="{StaticResource OpacityHover}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="#000000" Opacity="{StaticResource OpacityPressed}" />
            <SolidColorBrush x:Key="SelectedFillBrush" Color="{ThemeResource SystemAccentColorDark1}" Opacity="{StaticResource OpacitySelected}" />
            <SolidColorBrush x:Key="DividerBrush" Color="#000000" Opacity="{StaticResource OpacityDivider}" />
            <SolidColorBrush x:Key="EdgeHighlightBrush" Color="#FFFFFF" Opacity="0.80" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemAccentColorDark1}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="StatusTintBrush" Color="#000000" Opacity="{StaticResource OpacityHover}" />

            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="PanelFillBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="GlassBorderBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="HoverFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="HoverFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="PressedFillBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="PressedFillBrush" />
            <StaticResource x:Key="FocusStrokeColorOuterBrush" ResourceKey="FocusBrush" />
        </ResourceDictionary>

        <!-- ======================================================== high contrast: no glass, system colours only -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="PanelFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ElevatedFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ElevatedBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HoverFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PressedFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SelectedFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EdgeHighlightBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="FocusBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusTintBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
