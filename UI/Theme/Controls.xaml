<!--
    FrameBurst component styles, built only from the tokens in Tokens.xaml. Screens use these keys instead of
    styling controls locally.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FrameBurst.UI">

    <!-- ============================================================ surfaces -->

    <!-- Level 1: groups, panels. -->
    <Style x:Key="GlassSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
    </Style>

    <!-- Level 2: anything floating above level 1. -->
    <Style x:Key="ElevatedSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ElevatedFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ElevatedBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
    </Style>

    <!-- Window footer / command bar strip (Save, Cancel, dialog buttons). -->
    <Style x:Key="FooterBarStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource PanelFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="{StaticResource FooterPadding}" />
        <Setter Property="ColumnSpacing" Value="{StaticResource Space8}" />
    </Style>

    <!-- Round tinted plate behind a status glyph (dialogs, update state). -->
    <Style x:Key="StatusPlateStyle" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource StatusTintBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- ============================================================ settings -->

    <Style TargetType="ui:SettingsGroup">
        <Setter Property="Background" Value="{ThemeResource GlassFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
    </Style>

    <Style TargetType="ui:SettingsRow">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource RowMinHeight}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingsRow">
                    <Grid MinHeight="{TemplateBinding MinHeight}">
                        <Rectangle x:Name="Divider" Height="1" VerticalAlignment="Top" Fill="{ThemeResource DividerBrush}" Visibility="Collapsed" />
                        <Grid x:Name="LayoutRoot" Padding="{TemplateBinding Padding}" ColumnSpacing="{StaticResource Space16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Fixed-size icon cell keeps every header on the same left edge, icon or not. -->
                            <ContentPresenter Width="20" Height="20" VerticalAlignment="Center"
                                              Content="{TemplateBinding ResolvedIcon}"
                                              FontSize="{StaticResource RowIconSize}"
                                              Foreground="{ThemeResource TextPrimaryBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="DescriptionPresenter" Content="{TemplateBinding Description}" Visibility="Collapsed"
                                                  FontSize="12" LineHeight="16" TextWrapping="Wrap"
                                                  Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>

                            <ContentPresenter x:Name="ActionPresenter" Grid.Column="2"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" />

                            <ContentPresenter x:Name="FooterPresenter" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                              Content="{TemplateBinding Footer}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small explanatory line under a section heading (replaces a full InfoBar for static tips). -->
    <Style x:Key="InlineHintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Margin" Value="2,-2,0,10" />
    </Style>

    <!-- ============================================================ buttons
         Primary   - the one main action of a surface (accent fill)
         Secondary - everything else (stock button: subtle fill + stroke)
         Ghost     - low-emphasis inline actions (no fill until hover)
         Destructive - irreversible actions (danger text, still requires a confirmation flow)
         Icon      - square, glyph only; always give it a ToolTip and AutomationProperties.Name -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,5,16,6" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,5,16,6" />
    </Style>
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,5,12,6" />
    </Style>
    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="16,5,16,6" />
        <Setter Property="Foreground" Value="{ThemeResource DangerBrush}" />
    </Style>
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <!-- Text link styled like body text in the accent colour, aligned flush with surrounding text. -->
    <Style x:Key="InlineLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================================================ flyouts -->
    <Style x:Key="TrayMenuPresenterStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSurface}" />
    </Style>
</ResourceDictionary>
