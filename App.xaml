<Application
    x:Class="FrameBurst.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- FrameBurst design system: tokens first, then the component styles built from them. -->
                <ResourceDictionary Source="ms-appx:///UI/Theme/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
