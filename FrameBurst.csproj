<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWinUI>true</UseWinUI>
    <ImportFrameworkWinFXTargets>true</ImportFrameworkWinFXTargets>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FrameBurst.ico</ApplicationIcon>
    <AssemblyName>FrameBurst</AssemblyName>
    <RootNamespace>FrameBurst</RootNamespace>
    <Version>1.2.0</Version>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <Product>FrameBurst</Product>
    <Description>GPU-accelerated screenshot tool</Description>
    <Copyright>Copyright (C) 2026 Luno. Licensed under the GNU GPL v3.0.</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Gpu\Shaders.hlsl" LogicalName="FrameBurst.Shaders.hlsl" />
    <EmbeddedResource Include="Assets\FrameBurst.ico" LogicalName="FrameBurst.FrameBurst.ico" />
    <Content Include="Assets\FrameBurst.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
